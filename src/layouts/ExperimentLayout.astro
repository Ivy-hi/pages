---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Behavioral Experiment Preview",
	description = "Interactive preview of a behavioral experiment.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<meta name="color-scheme" content="light" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/hy_logo.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: #fff;
		color: #161616;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-width: 100%;
		height: 100%;
		min-height: 100%;
		background: #fff;
	}

	body {
		overflow: hidden;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	[hidden] {
		display: none !important;
	}
</style>
