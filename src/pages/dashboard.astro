---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Yi Han Dashboard">
	<main class="dashboard">
		<section id="login-view" class="login-view">
			<div class="login-panel">
				<img src="/hy_logo.svg" alt="" width="40" height="40" />
				<h1>Dashboard</h1>
				<form id="login-form">
					<label>
						<span>Password</span>
						<input type="password" name="password" autocomplete="current-password" required />
					</label>
					<button type="submit">Sign in</button>
				</form>
				<p id="login-error" class="error" role="alert"></p>
			</div>
		</section>

		<section id="app-view" class="app-view" hidden>
			<header class="topbar">
				<div>
					<p class="eyebrow">Yi Han</p>
					<h1>Coordination Desk</h1>
				</div>
				<div class="top-actions">
					<span id="sync-status">Loading</span>
					<button type="button" id="refresh-button">Refresh</button>
					<button type="button" id="logout-button">Sign out</button>
				</div>
			</header>

			<section class="metrics" aria-label="Summary">
				<div>
					<span id="metric-projects">0</span>
					<p>Projects</p>
				</div>
				<div>
					<span id="metric-tasks">0</span>
					<p>Open tasks</p>
				</div>
				<div>
					<span id="metric-schedule">0</span>
					<p>Schedule blocks</p>
				</div>
				<div>
					<span id="metric-proposals">0</span>
					<p>Pending proposals</p>
				</div>
			</section>

			<section class="proposals-band" aria-labelledby="proposals-title">
				<div class="section-head">
					<div>
						<p class="eyebrow">Inbox</p>
						<h2 id="proposals-title">Pending Proposals</h2>
					</div>
				</div>
				<div id="proposal-list" class="proposal-list"></div>
			</section>

			<div class="workspace">
				<section class="work-section" aria-labelledby="projects-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">GTD</p>
							<h2 id="projects-title">Current Projects</h2>
						</div>
					</div>

					<form id="project-form" class="inline-form">
						<input name="name" placeholder="Project name" required />
						<select name="priority" aria-label="Priority">
							<option>P0</option>
							<option>P1</option>
							<option selected>P2</option>
							<option>P3</option>
						</select>
						<input name="progress" type="number" min="0" max="100" value="0" aria-label="Progress" />
						<button type="submit">Add project</button>
						<textarea name="description" placeholder="Description"></textarea>
					</form>

					<div id="project-list" class="item-list"></div>

					<div class="subsection-head">
						<h3>Tasks</h3>
					</div>
					<form id="task-form" class="inline-form task-form">
						<input name="title" placeholder="Task title" required />
						<select name="project_id" aria-label="Project"></select>
						<select name="priority" aria-label="Priority">
							<option>P0</option>
							<option>P1</option>
							<option selected>P2</option>
							<option>P3</option>
						</select>
						<input name="estimate_minutes" type="number" min="0" placeholder="Minutes" />
						<input name="due_at" type="datetime-local" aria-label="Due at" />
						<button type="submit">Add task</button>
						<textarea name="description" placeholder="Description"></textarea>
					</form>
					<div id="task-list" class="item-list"></div>
				</section>

				<section class="work-section" aria-labelledby="schedule-title">
					<div class="section-head">
						<div>
							<p class="eyebrow">Calendar</p>
							<h2 id="schedule-title">Schedule</h2>
						</div>
					</div>

					<form id="schedule-form" class="inline-form schedule-form">
						<input name="title" placeholder="Block title" required />
						<input name="start_at" type="datetime-local" required aria-label="Start" />
						<input name="end_at" type="datetime-local" required aria-label="End" />
						<select name="project_id" aria-label="Project"></select>
						<select name="task_id" aria-label="Task"></select>
						<button type="submit">Add block</button>
						<textarea name="description" placeholder="Description"></textarea>
					</form>

					<div id="schedule-list" class="item-list"></div>

					<div class="subsection-head">
						<h3>Agent Keys</h3>
					</div>
					<form id="agent-form" class="inline-form agent-form">
						<input name="name" placeholder="Agent name" required />
						<button type="submit">Create key</button>
					</form>
					<div id="new-key" class="key-output" hidden></div>
					<div id="agent-list" class="item-list compact"></div>
				</section>
			</div>
		</section>
	</main>
</Layout>

<script is:inline>
	const state = {
		data: null,
		newAgentKey: "",
	};

	const $ = (selector) => document.querySelector(selector);

	const priorityOptions = (selected = "P2") =>
		["P0", "P1", "P2", "P3"].map((value) => `<option ${value === selected ? "selected" : ""}>${value}</option>`).join("");

	const projectOptions = (selected = "") => {
		const projects = state.data?.projects || [];
		return `<option value="">No project</option>${projects.map((project) =>
			`<option value="${escapeHtml(project.id)}" ${project.id === selected ? "selected" : ""}>${escapeHtml(project.name)}</option>`
		).join("")}`;
	};

	const taskOptions = (selected = "") => {
		const tasks = state.data?.tasks || [];
		return `<option value="">No task</option>${tasks.map((task) =>
			`<option value="${escapeHtml(task.id)}" ${task.id === selected ? "selected" : ""}>${escapeHtml(task.title)}</option>`
		).join("")}`;
	};

	async function api(path, options = {}) {
		const response = await fetch(`/api/v1${path}`, {
			method: options.method || "GET",
			credentials: "include",
			headers: options.body ? { "Content-Type": "application/json" } : {},
			body: options.body ? JSON.stringify(options.body) : undefined,
		});
		const payload = await response.json().catch(() => ({}));
		if (!response.ok) {
			throw new Error(payload.message || payload.error || "Request failed");
		}
		return payload;
	}

	async function boot() {
		const session = await api("/admin/session").catch(() => ({ authenticated: false }));
		if (session.authenticated) {
			await loadDashboard();
		} else {
			showLogin();
		}
	}

	async function loadDashboard() {
		setStatus("Loading");
		state.data = await api("/admin/dashboard");
		renderDashboard();
		setStatus("Synced");
	}

	function showLogin() {
		$("#login-view").hidden = false;
		$("#app-view").hidden = true;
	}

	function showApp() {
		$("#login-view").hidden = true;
		$("#app-view").hidden = false;
	}

	function setStatus(text) {
		$("#sync-status").textContent = text;
	}

	function renderDashboard() {
		showApp();
		renderMetrics();
		renderForms();
		renderProposals();
		renderProjects();
		renderTasks();
		renderSchedule();
		renderAgents();
	}

	function renderMetrics() {
		const data = state.data;
		$("#metric-projects").textContent = data.projects.length;
		$("#metric-tasks").textContent = data.tasks.filter((task) => !["done", "canceled"].includes(task.status)).length;
		$("#metric-schedule").textContent = data.schedule_blocks.length;
		$("#metric-proposals").textContent = data.proposals.filter((proposal) => proposal.status === "pending").length;
	}

	function renderForms() {
		document.querySelectorAll('select[name="project_id"]').forEach((select) => {
			const value = select.value;
			select.innerHTML = projectOptions(value);
		});
		document.querySelectorAll('select[name="task_id"]').forEach((select) => {
			const value = select.value;
			select.innerHTML = taskOptions(value);
		});
	}

	function renderProposals() {
		const proposals = state.data.proposals.filter((proposal) => proposal.status === "pending");
		$("#proposal-list").innerHTML = proposals.length
			? proposals.map(renderProposal).join("")
			: `<p class="empty">No pending proposals.</p>`;
	}

	function renderProposal(proposal) {
		const summary = proposalSummary(proposal);
		const payload = escapeHtml(JSON.stringify(proposal.payload, null, 2));
		const createTask = proposal.type === "task";
		const createSchedule = proposal.type === "calendar_block";
		const updateProject = proposal.type === "project_update";
		return `
			<form class="proposal-item" data-proposal-id="${escapeHtml(proposal.id)}">
				<div class="proposal-summary">
					<div class="proposal-heading">
						<div>
							<p class="proposal-source">${escapeHtml(proposal.agent_name)} · ${formatDate(proposal.created_at)}</p>
							<h3>${escapeHtml(summary.title)}</h3>
						</div>
						<span class="proposal-type">${escapeHtml(summary.typeLabel)}</span>
					</div>
					${summary.chips.length ? `<div class="proposal-meta">${summary.chips.map(renderChip).join("")}</div>` : ""}
					${summary.description ? `<p class="proposal-description">${escapeHtml(summary.description)}</p>` : ""}
					${summary.rows.length ? `<dl class="proposal-details">${summary.rows.map(renderDetail).join("")}</dl>` : ""}
				</div>
				<details class="payload-details">
					<summary>Raw payload / edit</summary>
					<textarea name="payload" spellcheck="false">${payload}</textarea>
				</details>
				<div class="proposal-actions">
					<label><input type="checkbox" name="create_task" ${createTask ? "checked" : ""} /> Task</label>
					<label><input type="checkbox" name="create_schedule_block" ${createSchedule ? "checked" : ""} /> Schedule</label>
					<label><input type="checkbox" name="update_project" ${updateProject ? "checked" : ""} /> Project</label>
					<input name="reviewer_note" placeholder="Note" />
					<button type="submit">Approve</button>
					<button type="button" data-action="reject-proposal" data-id="${escapeHtml(proposal.id)}">Reject</button>
				</div>
			</form>
		`;
	}

	function renderProjects() {
		const projects = state.data.projects;
		$("#project-list").innerHTML = projects.length
			? projects.map((project) => `
				<form class="item-row" data-entity="project" data-id="${escapeHtml(project.id)}">
					<div class="item-main">
						<input name="name" value="${escapeAttr(project.name)}" />
						<textarea name="description">${escapeHtml(project.description)}</textarea>
					</div>
					<select name="status">
						${["active", "waiting", "done", "archived"].map((status) => `<option ${status === project.status ? "selected" : ""}>${status}</option>`).join("")}
					</select>
					<select name="priority">${priorityOptions(project.priority)}</select>
					<input name="progress" type="number" min="0" max="100" value="${project.progress}" />
					<button type="submit">Save</button>
				</form>
			`).join("")
			: `<p class="empty">No projects yet.</p>`;
	}

	function renderTasks() {
		const tasks = state.data.tasks;
		$("#task-list").innerHTML = tasks.length
			? tasks.map((task) => `
				<form class="item-row" data-entity="task" data-id="${escapeHtml(task.id)}">
					<div class="item-main">
						<input name="title" value="${escapeAttr(task.title)}" />
						<textarea name="description">${escapeHtml(task.description)}</textarea>
						<p>${escapeHtml(task.project_name || "No project")} · ${task.estimate_minutes || 0} min · ${task.due_at ? formatDate(task.due_at) : "No due date"}</p>
					</div>
					<select name="project_id">${projectOptions(task.project_id || "")}</select>
					<select name="status">
						${["inbox", "next", "scheduled", "waiting", "done", "canceled"].map((status) => `<option ${status === task.status ? "selected" : ""}>${status}</option>`).join("")}
					</select>
					<select name="priority">${priorityOptions(task.priority)}</select>
					<input name="estimate_minutes" type="number" min="0" value="${task.estimate_minutes || ""}" />
					<input name="due_at" type="datetime-local" value="${toLocalInput(task.due_at)}" />
					<button type="submit">Save</button>
				</form>
			`).join("")
			: `<p class="empty">No tasks yet.</p>`;
	}

	function renderSchedule() {
		const blocks = state.data.schedule_blocks;
		$("#schedule-list").innerHTML = blocks.length
			? blocks.map((block) => `
				<form class="item-row schedule-row" data-entity="schedule" data-id="${escapeHtml(block.id)}">
					<div class="schedule-summary">
						<div class="item-title-row">
							<strong>${escapeHtml(block.title)}</strong>
							<span>${escapeHtml(block.status)}</span>
						</div>
						<p class="schedule-time">${formatRange(block.start_at, block.end_at)}</p>
						<div class="schedule-meta">
							${renderChip(block.project_name || "No project")}
							${block.task_title ? renderChip(block.task_title) : ""}
						</div>
						${block.description ? `<p class="schedule-description">${escapeHtml(block.description)}</p>` : ""}
					</div>
					<div class="schedule-actions">
						<button type="button" data-action="toggle-schedule-edit">Edit</button>
					</div>
					<div class="schedule-edit" hidden>
						<input name="title" value="${escapeAttr(block.title)}" aria-label="Title" />
						<input name="start_at" type="datetime-local" value="${toLocalInput(block.start_at)}" aria-label="Start" />
						<input name="end_at" type="datetime-local" value="${toLocalInput(block.end_at)}" aria-label="End" />
						<select name="project_id" aria-label="Project">${projectOptions(block.project_id || "")}</select>
						<select name="task_id" aria-label="Task">${taskOptions(block.task_id || "")}</select>
						<select name="status" aria-label="Status">
							${["planned", "focus", "meeting", "done", "canceled"].map((status) => `<option ${status === block.status ? "selected" : ""}>${status}</option>`).join("")}
						</select>
						<textarea name="description" placeholder="Description">${escapeHtml(block.description)}</textarea>
						<button type="submit">Save</button>
					</div>
				</form>
			`).join("")
			: `<p class="empty">No schedule blocks yet.</p>`;
	}

	function renderAgents() {
		const output = $("#new-key");
		output.hidden = !state.newAgentKey;
		output.innerHTML = state.newAgentKey
			? `<code>${escapeHtml(state.newAgentKey)}</code><button type="button" data-action="copy-key">Copy</button>`
			: "";

		$("#agent-list").innerHTML = state.data.agents.length
			? state.data.agents.map((agent) => `
				<div class="item-row agent-row">
					<div class="item-main">
						<strong>${escapeHtml(agent.name)}</strong>
						<p>${agent.scopes.map(escapeHtml).join(", ")} · ${agent.last_seen_at ? formatDate(agent.last_seen_at) : "Never seen"}</p>
					</div>
					<button type="button" data-action="toggle-agent" data-id="${escapeHtml(agent.id)}" data-active="${agent.active ? "1" : "0"}">
						${agent.active ? "Disable" : "Enable"}
					</button>
				</div>
			`).join("")
			: `<p class="empty">No agents yet.</p>`;
	}

	$("#login-form").addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.currentTarget;
		$("#login-error").textContent = "";
		const password = new FormData(form).get("password");
		try {
			await api("/admin/login", { method: "POST", body: { password } });
			form.reset();
			await loadDashboard();
		} catch (error) {
			$("#login-error").textContent = error.message;
		}
	});

	$("#logout-button").addEventListener("click", async () => {
		await api("/admin/logout", { method: "POST", body: {} }).catch(() => null);
		state.data = null;
		showLogin();
	});

	$("#refresh-button").addEventListener("click", () => loadDashboard().catch(showError));

	$("#project-form").addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.currentTarget;
		await saveProject(form);
		form.reset();
	});

	$("#task-form").addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.currentTarget;
		await saveTask(form);
		form.reset();
	});

	$("#schedule-form").addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.currentTarget;
		await saveSchedule(form);
		form.reset();
	});

	$("#agent-form").addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.currentTarget;
		const body = Object.fromEntries(new FormData(form));
		const result = await api("/admin/agents", { method: "POST", body }).catch(showError);
		if (!result) return;
		state.newAgentKey = result.api_key;
		form.reset();
		await loadDashboard();
	});

	document.addEventListener("submit", async (event) => {
		const form = event.target;
		if (!(form instanceof HTMLFormElement)) return;
		if (form.dataset.entity === "project") {
			event.preventDefault();
			await saveProject(form, form.dataset.id);
		}
		if (form.dataset.entity === "task") {
			event.preventDefault();
			await saveTask(form, form.dataset.id);
		}
		if (form.dataset.entity === "schedule") {
			event.preventDefault();
			await saveSchedule(form, form.dataset.id);
		}
		if (form.classList.contains("proposal-item")) {
			event.preventDefault();
			await approveProposal(form);
		}
	});

	document.addEventListener("click", async (event) => {
		const button = event.target.closest("button[data-action]");
		if (!button) return;
		if (button.dataset.action === "reject-proposal") {
			await api(`/admin/proposals/${button.dataset.id}/reject`, {
				method: "POST",
				body: { reviewer_note: "Rejected from dashboard" },
			}).then(loadDashboard).catch(showError);
		}
		if (button.dataset.action === "toggle-agent") {
			await api(`/admin/agents/${button.dataset.id}`, {
				method: "PATCH",
				body: { active: button.dataset.active !== "1" },
			}).then(loadDashboard).catch(showError);
		}
		if (button.dataset.action === "toggle-schedule-edit") {
			const form = button.closest("form");
			const editPanel = form?.querySelector(".schedule-edit");
			if (!editPanel) return;
			const nextOpen = editPanel.hidden;
			editPanel.hidden = !nextOpen;
			form.classList.toggle("is-editing", nextOpen);
			button.textContent = nextOpen ? "Close" : "Edit";
			if (nextOpen) {
				editPanel.querySelector("input, select, textarea")?.focus();
			}
		}
		if (button.dataset.action === "copy-key" && state.newAgentKey) {
			await navigator.clipboard.writeText(state.newAgentKey);
			setStatus("Copied");
		}
	});

	async function saveProject(form, id = "") {
		const data = Object.fromEntries(new FormData(form));
		const body = {
			name: data.name,
			description: data.description || "",
			status: data.status || "active",
			priority: data.priority || "P2",
			progress: Number(data.progress || 0),
		};
		await api(id ? `/admin/projects/${id}` : "/admin/projects", {
			method: id ? "PATCH" : "POST",
			body,
		}).then(loadDashboard).catch(showError);
	}

	async function saveTask(form, id = "") {
		const data = Object.fromEntries(new FormData(form));
		const body = {
			project_id: data.project_id || null,
			title: data.title,
			description: data.description || "",
			status: data.status || "inbox",
			priority: data.priority || "P2",
			estimate_minutes: data.estimate_minutes ? Number(data.estimate_minutes) : null,
			due_at: fromLocalInput(data.due_at),
		};
		await api(id ? `/admin/tasks/${id}` : "/admin/tasks", {
			method: id ? "PATCH" : "POST",
			body,
		}).then(loadDashboard).catch(showError);
	}

	async function saveSchedule(form, id = "") {
		const data = Object.fromEntries(new FormData(form));
		const body = {
			project_id: data.project_id || null,
			task_id: data.task_id || null,
			title: data.title,
			description: data.description || "",
			start_at: fromLocalInput(data.start_at),
			end_at: fromLocalInput(data.end_at),
			status: data.status || "planned",
		};
		await api(id ? `/admin/schedule-blocks/${id}` : "/admin/schedule-blocks", {
			method: id ? "PATCH" : "POST",
			body,
		}).then(loadDashboard).catch(showError);
	}

	async function approveProposal(form) {
		let payload;
		try {
			payload = JSON.parse(new FormData(form).get("payload"));
		} catch {
			showError(new Error("Proposal payload is not valid JSON"));
			return;
		}
		const data = new FormData(form);
		await api(`/admin/proposals/${form.dataset.proposalId}/approve`, {
			method: "POST",
			body: {
				payload,
				create_task: data.has("create_task"),
				create_schedule_block: data.has("create_schedule_block"),
				update_project: data.has("update_project"),
				reviewer_note: data.get("reviewer_note") || "",
			},
		}).then(loadDashboard).catch(showError);
	}

	function proposalSummary(proposal) {
		const payload = proposal.payload || {};
		const typeLabel = proposalTypeLabel(proposal.type);
		const title = payload.title || payload.project_name || payload.name || typeLabel;
		const description = payload.description || payload.project_description || "";
		const rows = proposalDetailRows(proposal.type, payload);
		const chips = [
			payload.priority,
			payload.project_name,
			payload.project_status || payload.status,
		].filter(Boolean);
		return { title, typeLabel, description, rows, chips };
	}

	function proposalTypeLabel(type) {
		return {
			task: "Task",
			calendar_block: "Schedule",
			project_update: "Project update",
		}[type] || type;
	}

	function proposalDetailRows(type, payload) {
		if (type === "task") {
			return [
				["Project", payload.project_name],
				["Estimate", formatMinutes(payload.estimate_minutes)],
				["Due", payload.due_at ? formatDate(payload.due_at) : ""],
			].filter(([, value]) => Boolean(value));
		}

		if (type === "calendar_block") {
			return [
				["When", payload.start_at && payload.end_at ? formatRange(payload.start_at, payload.end_at) : ""],
				["Project", payload.project_name],
				["Task", payload.task_title || payload.task_id],
			].filter(([, value]) => Boolean(value));
		}

		if (type === "project_update") {
			return [
				["Project", payload.project_name || payload.name],
				["Progress", payload.progress === undefined ? "" : `${payload.progress}%`],
				["Status", payload.project_status || payload.status],
				["Priority", payload.priority],
			].filter(([, value]) => Boolean(value));
		}

		return Object.entries(payload)
			.filter(([, value]) => typeof value === "string" || typeof value === "number")
			.slice(0, 4);
	}

	function renderDetail([label, value]) {
		return `<div><dt>${escapeHtml(label)}</dt><dd>${escapeHtml(value)}</dd></div>`;
	}

	function renderChip(value) {
		return `<span class="meta-chip">${escapeHtml(value)}</span>`;
	}

	function formatMinutes(minutes) {
		const value = Number(minutes);
		if (!Number.isFinite(value) || value <= 0) return "";
		if (value < 60) return `${value} min`;
		const hours = Math.floor(value / 60);
		const rest = value % 60;
		return rest ? `${hours}h ${rest}m` : `${hours}h`;
	}

	function showError(error) {
		setStatus(error.message || "Error");
	}

	function escapeHtml(value) {
		return String(value ?? "")
			.replaceAll("&", "&amp;")
			.replaceAll("<", "&lt;")
			.replaceAll(">", "&gt;")
			.replaceAll('"', "&quot;")
			.replaceAll("'", "&#039;");
	}

	function escapeAttr(value) {
		return escapeHtml(value).replaceAll("\n", " ");
	}

	function formatDate(value) {
		if (!value) return "";
		return new Intl.DateTimeFormat("en", {
			timeZone: "Asia/Shanghai",
			month: "short",
			day: "numeric",
			hour: "2-digit",
			minute: "2-digit",
		}).format(new Date(value));
	}

	function formatRange(start, end) {
		return `${formatDate(start)} - ${formatDate(end)}`;
	}

	function toLocalInput(value) {
		if (!value) return "";
		const date = new Date(value);
		const offset = date.getTimezoneOffset();
		const local = new Date(date.getTime() - offset * 60000);
		return local.toISOString().slice(0, 16);
	}

	function fromLocalInput(value) {
		return value ? new Date(value).toISOString() : null;
	}

	boot().catch(() => showLogin());
</script>

