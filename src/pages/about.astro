---
import { Image } from "astro:assets";
import aboutImage from "../assets/photography/aboutme.png";
import { portfolio } from "../data/portfolio";
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
---

<PortfolioLayout
	title={`About me | ${portfolio.name}`}
	description={`About ${portfolio.name}, a Ph.D. candidate at Peking University and a photographer.`}
>
	<article class="about-page">
		<header class="about-head">
			<p class="about-kicker">Behind the photographs</p>
			<h1>About me</h1>
		</header>

		<figure class="about-image">
			<Image
				src={aboutImage}
				alt="A football player striking the ball on an outdoor pitch"
				width={1536}
				format="webp"
				quality={82}
			/>
		</figure>

		<div class="about-copy">
			<p class="about-lede">
				I am Yi Han, a Ph.D. candidate and a photographer.
			</p>
			<p>
				I am in the Department of Control Science and Systems Engineering at Peking University in
				Beijing, China. My research focuses on mathematical modeling and analysis of multi-agent
				systems, drawing on dynamical systems, fairness, and game theory to study interaction, resource
				allocation, and collective outcomes.
			</p>
			<p>
				Photography is a parallel practice of observation and memory. This portfolio gathers everyday
				landscapes, quiet structures, and the traces people leave behind, along with occasional notes
				about the places and ideas around them.
			</p>
		</div>
	</article>
</PortfolioLayout>

<style>
	.about-page {
		width: min(1120px, 100%);
		margin: 0 auto;
	}

	.about-head {
		margin-bottom: 1.4rem;
	}

	.about-kicker {
		margin: 0 0 0.35rem;
		color: var(--portfolio-muted);
		font-size: 15px;
	}

	h1 {
		margin: 0;
		font-family: var(--portfolio-display);
		font-size: 42px;
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0;
	}

	.about-image {
		margin: 0;
		overflow: hidden;
		aspect-ratio: 3 / 2;
		border-radius: 2px;
		background: var(--portfolio-surface);
	}

	.about-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about-copy {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: 2.5rem 4rem;
		width: min(900px, 100%);
		margin: 2rem auto 0;
	}

	.about-copy p {
		margin: 0;
		color: var(--portfolio-muted);
	}

	.about-copy .about-lede {
		grid-row: span 2;
		color: var(--portfolio-fg);
		font-family: var(--portfolio-display);
		font-size: 29px;
		line-height: 1.28;
	}

	@media (max-width: 760px) {
		h1 {
			font-size: 36px;
		}

		.about-copy {
			grid-template-columns: 1fr;
			gap: 1.2rem;
		}

		.about-copy .about-lede {
			grid-row: auto;
			font-size: 26px;
		}
	}
</style>
