{
  "name": "nuclear-nova",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/strip-unreferenced-assets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "pages:dev": "wrangler pages dev dist",
    "d1:apply:local": "wrangler d1 migrations apply agent-scheduler --local",
    "d1:apply:remote": "wrangler d1 migrations apply agent-scheduler --remote",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@lucide/astro": "^1.28.0",
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "wrangler": "^4.92.0"
  }
}
